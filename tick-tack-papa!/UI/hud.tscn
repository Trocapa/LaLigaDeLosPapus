[sub_resource type="Shader" id="WipeShader"]
code = "shader_type canvas_item;
uniform float radio = 1.5;
void fragment() {
	vec2 uv = UV - vec2(0.5);
	uv.x *= 1.77778;
	float d = length(uv);
	float a = smoothstep(radio - 0.08, radio, d);
	COLOR = vec4(0.0, 0.0, 0.0, a);
}"

