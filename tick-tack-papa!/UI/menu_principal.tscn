[gd_scene format=3]

[ext_resource type="Script" path="res://UI/menu_principal.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://assets/Play.png" id="1_play"]
[ext_resource type="AudioStream" path="res://assets/Sounds/menu.mp3" id="1_main"]

[node name="MenuPrincipal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Titulo" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "TICK TACK PAPA!"
horizontal_alignment = 1

[node name="Sub" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "La papa caliente debe llegar al agua sin explotar.
A/D: moverse - FLECHA ARRIBA / W: saltar - ESPACIO: dash
R: reintentar - ESC: pausa"
horizontal_alignment = 1

[node name="Jugar" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 60)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "JUGAR"
icon = ExtResource("1_play")
expand_icon = true

[node name="Musica" type="AudioStreamPlayer" parent="."]
stream = ExtResource("1_main")
autoplay = true
